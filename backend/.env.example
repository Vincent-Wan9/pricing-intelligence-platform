DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pricing_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
COMPETITOR_CRAWL_SCHEDULE_SECONDS=21600
DEMAND_FORECAST_SCHEDULE_SECONDS=86400
DEMAND_FORECAST_DEFAULT_HORIZON_DAYS=7
DEMAND_FORECAST_MIN_HISTORY_DAYS=21
CELERY_TASK_ALWAYS_EAGER=false
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_DEFAULT_EXP_MINUTES=30
