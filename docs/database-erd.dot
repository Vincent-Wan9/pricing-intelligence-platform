digraph PricingIntelligenceERD {
  graph [
    label="Pricing Intelligence Platform — Entity Relationship Diagram"
    labelloc=t fontsize=24 fontname="Arial Bold" fontcolor="#263238"
    bgcolor="#FAFAFA" pad=0.35 nodesep=0.55 ranksep=0.85
    splines=ortho outputorder=edgesfirst
  ];
  node [shape=plain fontname="Arial" fontsize=10];
  edge [color="#607D8B" penwidth=1.2 arrowsize=0.7 fontname="Arial" fontsize=9 fontcolor="#455A64"];

  users [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>users</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">hashed_password</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">varchar?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">varchar?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">user_roles</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">last_login</TD><TD ALIGN="LEFT">datetime?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
    </TABLE>>];

  categories [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>categories</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text?</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">UUID?</TD></TR>
    </TABLE>>];

  pricing_rules [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>pricing_rules</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">rule_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">rule_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">rule_description</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">rule_type</TD><TD ALIGN="LEFT">rule_type_enum</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">datetime?</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">UUID?</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT">UUID?</TD></TR>
    </TABLE>>];

  products [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>products</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">sku</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">rule_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">base_price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">current_price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">min_price / max_price</TD><TD ALIGN="LEFT">decimal?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">target_margin</TD><TD ALIGN="LEFT">decimal?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">safety_stock</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">auto_pricing_enabled</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD></TR>
    </TABLE>>];

  inventories [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>inventories</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">inventory_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">vendor</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">lead_time</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">cost_per_unit</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">on_hand_qty</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
    </TABLE>>];

  demand_forecasts [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>demand_forecasts</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">forecast_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">forecast_date</TD><TD ALIGN="LEFT">datetime</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">predicted_demand</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">model_name</TD><TD ALIGN="LEFT">varchar?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">confidence_score</TD><TD ALIGN="LEFT">decimal?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
    </TABLE>>];

  competitors [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>competitors</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">competitor_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">competitor_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD>UK</TD><TD ALIGN="LEFT">website_url</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
    </TABLE>>];

  competitor_products [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>competitor_products</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">competitor_product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">competitor_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">competitor_sku</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">competitor_product_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">competitor_product_url</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
    </TABLE>>];

  competitor_prices [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>competitor_prices</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">price_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">competitor_product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">competitor_price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">stock_qty</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">in_stock</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">crawl_timestamp</TD><TD ALIGN="LEFT">datetime</TD></TR>
    </TABLE>>];

  crawl_jobs [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>crawl_jobs</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">competitor_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT">datetime?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">records_collected</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT">text?</TD></TR>
    </TABLE>>];

  price_recommendations [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>price_recommendations</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">recommendation_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">rule_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">current_price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">recommended_price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">recommendation_reason</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">generated_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">reviewed_by</TD><TD ALIGN="LEFT">UUID?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">reviewed_at</TD><TD ALIGN="LEFT">datetime?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">review_reason</TD><TD ALIGN="LEFT">text?</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">applied_by</TD><TD ALIGN="LEFT">UUID?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">applied_at</TD><TD ALIGN="LEFT">datetime?</TD></TR>
    </TABLE>>];

  product_price_histories [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#90A4AE" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#F3A89A"><B>product_price_histories</B></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT">history_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">UUID</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">old_price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">new_price</TD><TD ALIGN="LEFT">decimal</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">change_reason</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">recommendation_id</TD><TD ALIGN="LEFT">UUID?</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT">changed_by</TD><TD ALIGN="LEFT">UUID?</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">changed_at</TD><TD ALIGN="LEFT">datetime</TD></TR>
    </TABLE>>];

  { rank=same; categories; pricing_rules; users; }
  { rank=same; inventories; products; demand_forecasts; }
  { rank=same; competitors; competitor_products; competitor_prices; }
  { rank=same; crawl_jobs; price_recommendations; product_price_histories; }

  categories -> categories [label=" 0..1 parent"];
  categories -> products [label=" 1 : many"];
  pricing_rules -> products [label=" 1 : many"];
  users -> pricing_rules [label=" created/updated by" constraint=false];
  products -> inventories [label=" 1 : many"];
  products -> demand_forecasts [label=" 1 : many"];
  products -> competitor_products [label=" 1 : many"];
  competitors -> competitor_products [label=" 1 : many"];
  competitor_products -> competitor_prices [label=" 1 : many"];
  competitors -> crawl_jobs [label=" 1 : many"];
  products -> price_recommendations [label=" 1 : many"];
  pricing_rules -> price_recommendations [label=" 1 : many"];
  users -> price_recommendations [label=" reviews / applies" constraint=false];
  products -> product_price_histories [label=" 1 : many"];
  price_recommendations -> product_price_histories [label=" 0..1 : many"];
  users -> product_price_histories [label=" changed by" constraint=false];
}
